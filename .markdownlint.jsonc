{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.41.1/schema/markdownlint-config-schema.json",
	"default": true,

	// Use hash headings, dash bullets, and fenced code blocks consistently.
	"MD003": { "style": "atx" },
	"MD004": { "style": "dash" },
	"MD046": { "style": "fenced" },
	"MD048": { "style": "backtick" },
	// Let code examples follow the project's tab-based Prettier style.
	"MD010": { "code_blocks": false },

	// Let editors wrap prose without splitting URLs, commands, or table rows.
	"MD013": false,

	// Keep tables readable in source with outer pipes and aligned columns.
	"MD055": { "style": "leading_and_trailing" },
	"MD060": { "style": "aligned" },
}
